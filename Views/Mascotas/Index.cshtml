@model IEnumerable<PawCare.Models.Mascota>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>PawCare - Veterinaria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>

    <div class="container mt-4">

        <h1 class="text-center mb-4">Veterinaria PawCare</h1>

        <div class="row">

            <!-- FORMULARIO -->
            <div class="col-lg-4">

                <h2>Registrar Mascota</h2>

                <form asp-action="Index" method="post">

                    <div class="mb-3">
                        <label asp-for="First().NombreMascota" class="form-label">
                            Nombre de la mascota
                        </label>
                        <input asp-for="First().NombreMascota" class="form-control" />
                        <span asp-validation-for="First().NombreMascota"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="First().NombreDueno" class="form-label">
                            Nombre del dueño
                        </label>
                        <input asp-for="First().NombreDueno" class="form-control" />
                        <span asp-validation-for="First().NombreDueno"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select name="Tipo" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="Perro">Perro</option>
                            <option value="Gato">Gato</option>
                            <option value="Otro">Otros</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Edad</label>
                        <input name="Edad" type="number" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input name="Telefono" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea name="Observaciones"
                                  class="form-control"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Registrar Mascota
                    </button>

                </form>

            </div>


            <!-- TABLA -->
            <div class="col-lg-8">

                <h2>Mascotas Registradas</h2>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Dueño</th>
                                <th>Tipo</th>
                                <th>Edad</th>
                                <th>Teléfono</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var mascota in Model)
                            {
                                <tr>
                                    <td>@mascota.NombreMascota</td>
                                    <td>@mascota.NombreDueno</td>
                                    <td>@mascota.Tipo</td>
                                    <td>@mascota.Edad</td>
                                    <td>@mascota.Telefono</td>
                                    <td>@mascota.Observaciones</td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>